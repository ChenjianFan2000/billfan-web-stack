[Unit]
Description=Qihua Paper Assistant FastAPI Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www
EnvironmentFile=/etc/qh-paper-assistant/app.env
ExecStart=/var/www/.venv/bin/uvicorn app.main:app --host ${APP_HOST} --port ${APP_PORT}
Restart=always
RestartSec=3
TimeoutStopSec=30

# basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www

[Install]
WantedBy=multi-user.target
