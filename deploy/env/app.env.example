# Application
APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8000
APP_WORKERS=1

# Domain
APP_PRIMARY_DOMAIN=billfan.cn
APP_ALT_DOMAIN=www.billfan.cn

# Paths
APP_BASE_DIR=/var/www
APP_DATA_DIR=/var/www/data
APP_DB_PATH=/var/www/data/db.sqlite
APP_PDFS_DIR=/var/www/data/pdfs
APP_TEXTS_DIR=/var/www/data/texts
APP_CHAT_FILES_DIR=/var/www/data/chat_files
APP_EXPORT_DIR=/var/www/data/exports
APP_LOG_DIR=/var/www/logs

# Auth
JWT_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=720
DEFAULT_USERNAME=其华
DEFAULT_PASSWORD=jclcgs

# Model provider
QWEN_MODEL=claude-opus-4-6
QWEN_VL_MODEL=qwen-vl-plus
QWEN_BASE_URL=https://api.vectorengine.ai/v1
DASHSCOPE_API_KEY=REPLACE_WITH_REAL_KEY
AIMATH_MODEL=GPT-5.5-high
AIMATH_FALLBACK_MODEL=claude-opus-4-6

# Exa
EXA_API_KEY=REPLACE_WITH_REAL_KEY
EXA_MCP_URL=https://mcp.exa.ai/mcp
EXA_MCP_TOOL_NAME=web_search_exa

# paper_search MCP (optional)
PAPER_SEARCH_MCP_URL=
PAPER_SEARCH_MCP_TOOL_NAME=search_papers

# Optional for paper_search MCP
SEMANTIC_SCHOLAR_API_KEY=

# Optional CORS allow-list (comma-separated)
CORS_ORIGINS=https://billfan.cn,https://www.billfan.cn,https://aimath.billfan.cn
