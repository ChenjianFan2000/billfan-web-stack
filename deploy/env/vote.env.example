# 请由 scripts/deploy/deploy_vote.sh 首次生成 /etc/dankou-vote/vote.env。
# 这里都是示例；真实管理员密码和签名密钥不得提交到 GitHub。
VOTE_DB_PATH=/var/lib/dankou-vote/vote.sqlite3
VOTE_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS
VOTE_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
VOTE_COOKIE_SECURE=true
VOTE_ALLOWED_ORIGINS=https://vote.billfan.cn
VOTE_FINGERPRINT_RECOVERY=true
VOTE_VOTE_INTERVAL_MS=800
VOTE_MESSAGE_INTERVAL_MS=5000
